generator client {
  provider = "prisma-client-js"
}

// SQLite (Yerel Geliştirme İçin)
// Vercel'e yüklemeden hemen önce burayı yorum satırı yapın.
// datasource db {
//   provider = "sqlite"
//   url      = env("DATABASE_URL")
// }

// PostgreSQL (Vercel / Supabase Canlı Ortam İçin)
// Vercel'e yüklerken üstteki SQLite kısmını gizleyip, burayı açın.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Project {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  location     String
  status       String
  beforeImage  String?
  afterImage   String
  seoTitle     String?
  seoDesc      String?
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String
  subject   String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  icon        String?
  seoTitle    String?
  seoDesc     String?
}

model SiteSettings {
  id          String   @id @default(cuid())
  companyName String
  email       String
  phone       String
  address     String
  mapEmbedUrl String
  schemaJson  String?
  logoUrl     String?
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String
  content     String
  image       String?
  published   Boolean  @default(true)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
