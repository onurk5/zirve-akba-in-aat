generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Project {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  location     String
  status       String
  beforeImage  String?
  afterImage   String
  seoTitle     String?
  seoDesc      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String
  subject   String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  icon        String?
  seoTitle    String?
  seoDesc     String?
}

model SiteSettings {
  id          String   @id @default(cuid())
  companyName String
  email       String
  phone       String
  address     String
  mapEmbedUrl String
  schemaJson  String?
}
